SSHKEY DEFINITIONS ::=
BEGIN

--
-- SSHKEY is a GSS-API mechanism that authenticates peers using SSH public
-- keys.  The corresponding Internet-Draft source is
-- draft-dowdeswell-kitten-gss-sshkey-00.xml.
--
-- All context-establishment tokens are DER encodings of SshKeyToken.
--

SshKeyCtx ::= SEQUENCE {
	  user	[0] OCTET STRING	OPTIONAL
	, key	[1] OCTET STRING	OPTIONAL
	, h	[2] OCTET STRING	OPTIONAL	-- rolling transcript hash
}

EncCtx ::= SEQUENCE {
	  encPart	[0] OCTET STRING
}

--
-- SshKeyUserAuth is DER encoded and encrypted into EncSshKeyUserAuth.
-- username contains the requested authorization identity.  sig proves
-- possession of the corresponding SSH user private key.  keytype is the SSH
-- public key algorithm name, key is the raw SSH public key blob, sigtype is
-- the SSH signature algorithm name, and sig is the SSH signature blob.
--
-- User authentication is not a distinct cleartext first-message step.
-- EncSshKeyUserAuth may appear in any token sent after the sender knows the
-- peer ECDH public key and can derive the exchange session key.  This lets
-- initiator-first exchanges keep the username encrypted without adding a
-- round trip, and lets acceptor-first exchanges carry encrypted userauth in
-- the initiator's first response.

SshKeyUserAuth ::= SEQUENCE {
	  username	[0] OCTET STRING
	, keytype	[1] OCTET STRING
	, key		[2] OCTET STRING
	, sigtype	[3] OCTET STRING
	, sig		[4] OCTET STRING
}

EncSshKeyUserAuth ::= OCTET STRING

--
-- SshKeyHostAuth proves possession of the acceptor host key.  keytype is the
-- SSH public key algorithm name, key is the raw SSH public key blob, sigtype
-- is an SSH signature algorithm name, and sig is the SSH signature blob.
-- The host signature authenticates the acceptor's ECDH contribution and the
-- associated algorithm and name context.

SshKeyHostAuth ::= SEQUENCE {
	  keytype	[0] OCTET STRING
	, key		[1] OCTET STRING
	, sigtype	[2] OCTET STRING
	, sig		[3] OCTET STRING
}

--
-- The initiator sends its supported signature algorithm names in sigtypes.
-- The acceptor replies with the signature algorithm names it is willing to
-- accept for user authentication.  SSH public key type and signature type are
-- separate because RSA public keys may be used with ssh-rsa, rsa-sha2-256, or
-- rsa-sha2-512 signatures.
--
-- The initiator should optimistically sign the first encrypted userauth it can
-- produce after it has enough ECDH material to derive the session key.  If
-- the acceptor cannot accept that signature algorithm, it returns
-- CONTINUE-NEEDED with an encrypted server context and a narrower sigtypes
-- list.
--
-- GSS does not require the initiator to produce the first token.  When
-- gss_accept_sec_context() is called with no input token, the acceptor sends
-- the same kind of KEX token as a signed challenge.  The initiator then
-- returns its KEX public key, the reflected encrypted server context, and
-- encrypted userauth when available.
--
-- HTTP Negotiate is a natural acceptor-first carrier: a server can include an
-- acceptor-first GSS-SSHKEY token in a 401 WWW-Authenticate header, and the
-- client can return its KEX public key, encrypted userauth, key confirmation,
-- and reflected sctx in the Authorization header.
--
-- The anonymous ECDH profile derives its base session key using the same
-- SP800-108 HMAC-SHA256 counter-mode KDF inputs as Heimdal SAnon-X25519:
--
--	K1	= raw X25519 shared secret
--	label	= "sanon-x25519"
--	context	= initiator-pk || acceptor-pk || uint32(0) ||
--		  uint32(flags) || channel-binding application-data
--	L	= 128 bits
--
-- SSHKEY currently sends no SAnon-style optional protocol flags, so flags is
-- zero.  The derived base session key is used for any further tokens including
-- userauth and gss_wrap/gss_unwrap, etc.
--
-- SSHKEY uses RFC 4121 CFX token framing for per-message tokens, but it is a
-- new mechanism and does not support Kerberos DES, Triple-DES, RC4, or other
-- legacy RFC 4121 encryption types.  The current enctype profile is
-- aes128-cts-hmac-sha256-128.

SshKeyKEX ::= SEQUENCE {
	-- Negotiation part
	  kextypes	[0] OCTET STRING
	, enctypes	[1] OCTET STRING
	, sigtypes	[2] OCTET STRING

	-- Proposal part
	, kextype	[3] OCTET STRING	OPTIONAL
	, pk		[4] OCTET STRING	OPTIONAL
	, enctype	[5] OCTET STRING	OPTIONAL
	, nonce		[6] OCTET STRING	OPTIONAL
}

--
-- SshKeyFinished proves knowledge of the session key derived from the ECDH
-- exchange and transcript.  mac is computed with a key-confirmation key
-- derived from the exchange session key and covers the transcript hash, role,
-- and peer nonce.  It is not an SSH signature and does not require another
-- ssh-agent operation.

SshKeyFinished ::= SEQUENCE {
	  mac		[0] OCTET STRING
}

--
-- SshKeyServerContext is DER encoded and encrypted into SshKeyToken.sctx.
-- The client must return sctx unchanged with any continuation token so another
-- acceptor process with the same context-protection key can finish the
-- authentication.  The nonces are retained here so a stateless acceptor can
-- verify SshKeyFinished when the initiator returns.

SshKeyServerContext ::= SEQUENCE {
	  initiatorPk	[0] OCTET STRING	OPTIONAL
	, acceptorPk	[1] OCTET STRING
	, sessionKey	[2] OCTET STRING	OPTIONAL
	, initiatorSigtypes [3] OCTET STRING	OPTIONAL
	, acceptorSigtypes [4] OCTET STRING
	, acceptorSk	[5] OCTET STRING	OPTIONAL
	, initiatorNonce [6] OCTET STRING	OPTIONAL
	, acceptorNonce [7] OCTET STRING
}

--
-- XXXrcd: errors need to be expanded to some degree.

SshKeyStatus ::= INTEGER {
	  SSH-KEY-COMPLETE		(1)
	, SSH-KEY-CONTINUE-NEEDED	(2)
	, SSH-KEY-FAILURE		(3)
}

SshKeyToken ::= SEQUENCE {
	  status	[0] SshKeyStatus
	, kex		[1] SshKeyKEX		OPTIONAL
	, hostauth	[2] SshKeyHostAuth	OPTIONAL
	, encuserauth	[3] EncSshKeyUserAuth	OPTIONAL
	, cctx		[4] EncCtx		OPTIONAL
	, sctx		[5] EncCtx		OPTIONAL
	, finished	[6] SshKeyFinished	OPTIONAL
}

--
-- XXXrcd: how about?
--
-- SshKeyMessage ::= SEQUENCE {
--	  status	[0] SshKeyStatus
--	, kex		[1] SshKeyKEX		OPTIONAL
--	, hostauth	[2] SshKeyHostAuth	OPTIONAL
--	, encuserauth	[3] EncSshKeyUserAuth	OPTIONAL
-- }
--
-- SshKeyMessage ::= CHOICE {
--	  plain		[0] SshKeyMessage
--	, encPart	[1] OCTET STRING	// just an encrypted plain
-- }
--
-- SshKeyToken ::= SEQUENCE {
--	  token		[0] SshKeyMessage
--	, cctx		[1] EncCtx		OPTIONAL
--	, sctx		[2] EncCtx		OPTIONAL
-- }

END
