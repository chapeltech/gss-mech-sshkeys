+typedef OM_uint32 (*gss_sshkey_set_context_fields_fn)(OM_uint32 *,
+    OM_uint32, OM_uint32, const gss_sshkey_context_field *, size_t);
+
+static const u_char gss_sshkey_oid[] = {
+	0x2b, 0x06, 0x01, 0x04, 0x01, 0x86, 0x8d, 0x1f, 0x01
+};
+
+static int
+ssh_gssapi_stage_peer_address(struct ssh *ssh, Gssctxt *ctx)
+{
+	gss_sshkey_set_context_fields_fn set_context_fields;
+	gss_sshkey_context_field field;
+	const char *address = ssh_remote_ipaddr(ssh);
+	OM_uint32 major, minor;
+
+	if (ctx == NULL || ctx->oid == GSS_C_NO_OID ||
+	    ctx->oid->length != sizeof(gss_sshkey_oid) ||
+	    memcmp(ctx->oid->elements, gss_sshkey_oid,
+	    sizeof(gss_sshkey_oid)) != 0)
+		return 0;
+	set_context_fields = (gss_sshkey_set_context_fields_fn)dlsym(
+	    RTLD_DEFAULT, "gss_sshkey_set_context_fields");
+	if (set_context_fields == NULL) {
+		error_f("cannot resolve SSHKEY typed context integration");
+		return -1;
+	}
+	field = gss_sshkey_context_string(GSS_SSHKEY_FIELD_PEER_ADDRESS,
+	    address);
+	major = set_context_fields(&minor, GSS_SSHKEY_CONTEXT_SERVER,
+	    GSS_SSHKEY_CONTEXT_VERSION_1, &field, 1);
+	if (GSS_ERROR(major)) {
+		error_f("cannot stage SSHKEY peer address %s: %u/%u",
+		    address, major, minor);
+		return -1;
+	}
+	return 0;
+}
+
 int
 mm_answer_gss_accept_ctx(struct ssh *ssh, int sock, struct sshbuf *m)
 {
@@ -2013,7 +2053,10 @@ mm_answer_gss_accept_ctx(struct ssh *ssh, int sock, struct sshbuf *m)
 
 	if ((r = ssh_gssapi_get_buffer_desc(m, &in)) != 0)
 		fatal_fr(r, "ssh_gssapi_get_buffer_desc");
-	major = ssh_gssapi_accept_ctx(gsscontext, &in, &out, &flags);
+	if (ssh_gssapi_stage_peer_address(ssh, gsscontext) != 0)
+		major = GSS_S_FAILURE;
+	else
+		major = ssh_gssapi_accept_ctx(gsscontext, &in, &out, &flags);
 	free(in.value);
 
 	sshbuf_reset(m);
